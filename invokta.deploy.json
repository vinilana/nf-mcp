{
  "schemaVersion": 1,
  "entry": "dist/mcp-http.js",
  "env": {
    "required": [
      "BETTER_AUTH_URL",
      "SPEDY_API_KEY",
      "SPEDY_BASE_URL"
    ],
    "optional": [
      "BETTER_AUTH_JWKS_URL",
      "BETTER_AUTH_SECRET",
      "INVOKTA_HTTP_ALLOWED_HOSTS",
      "INVOKTA_HTTP_ALLOWED_ORIGINS",
      "INVOKTA_HTTP_HOST",
      "INVOKTA_HTTP_MAX_BODY_BYTES",
      "INVOKTA_HTTP_PORT",
      "MCP_RESOURCE_URL",
      "PORT"
    ]
  },
  "image": {
    "baseImage": "node:22-slim",
    "port": 3000
  },
  "healthcheck": {
    "expect": "alive"
  }
}
